# @meddleware/content-hub-ui — build-time environment
# Copy to .env.local for local dev (never commit .env.local).
# In production these are Docker --build-arg values baked into the static bundle.

# Product name shown in the header (an operator's own name for its hub).
# VITE_BRAND_NAME=Content hub

# Documentation URL shown in the footer (optional).
# VITE_DOCS_URL=https://docs.example.org/content-hub/

# The admin API is always same-origin (/api/v1); there is no API URL to configure.
